QMainWindow, QDialog {
    background-color: #111111;
    color: #F2F2F2;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

QWidget {
    color: #F2F2F2;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

/* Common Header Style */
.view-header {
    font-size: 28px;
    font-weight: 700;
    color: #F2F2F2;
    margin-bottom: 10px;
}

/* Sidebar styling */
#sidebar {
    background-color: #1C1C1C;
    border-right: 1px solid #2B2B2B;
    min-width: 220px;
}

#sidebar-logo {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 20px;
    padding: 30px 20px;
    color: #FF6524;
}

QPushButton {
    border: none;
    outline: none;
    font-family: "Inter", sans-serif;
    padding: 8px 16px;
    background-color: transparent;
}

QPushButton#nav-btn {
    color: #888888;
    text-align: left;
    padding: 12px 24px;
    font-weight: 500;
    font-size: 14px;
    border-radius: 0px;
}

QPushButton#nav-btn:hover {
    color: #F2F2F2;
    background-color: #2B2B2B;
}

QPushButton#nav-btn:checked {
    color: #FF6524;
    background-color: #111111;
    border-left: 3px solid #FF6524;
}

/* Primary Action Button */
QPushButton#primary {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                 stop: 0 #FF6524, stop: 1.0 #E8311A);
    color: #FFFFFF;
    padding: 10px 24px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 14px;
}

QPushButton#primary:hover {
    background-color: #E8311A;
}

QPushButton#primary:pressed {
    background-color: #E8311A;
    padding-top: 11px;
    padding-bottom: 9px;
}

/* Secondary/Ghost Button */
QPushButton#secondary {
    background-color: #2B2B2B;
    color: #F2F2F2;
    padding: 10px 24px;
    border-radius: 6px;
    font-weight: 500;
    font-size: 14px;
}

QPushButton#secondary:hover {
    background-color: #1C1C1C;
    border: 1px solid #2B2B2B;
}

/* Cancel Button */
QPushButton#cancel {
    border: 1px solid #E8311A;
    color: #E8311A;
    background-color: transparent;
    padding: 10px 24px;
    border-radius: 6px;
    font-weight: 500;
    font-size: 14px;
}

QPushButton#cancel:hover {
    background-color: #E8311A;
    color: #FFFFFF;
}

/* View Switcher */
QPushButton#view-switcher-btn {
    background-color: #2B2B2B;
    color: #888888;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: 500;
    font-size: 12px;
    margin-right: 4px;
}

QPushButton#view-switcher-btn:hover {
    background-color: #1C1C1C;
    color: #F2F2F2;
}

QPushButton#view-switcher-btn:checked {
    background-color: #FF6524;
    color: #FFFFFF;
}

/* Stat Card */
QWidget#stat-card {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                 stop: 0 #FF6524, stop: 1.0 #E8311A);
    border: none;
    border-radius: 12px;
}

#stat-value, #stat-title {
    background: transparent;
    border: none;
}

#stat-value {
    font-size: 36px;
    font-weight: 800;
    color: #FFFFFF;
}

#stat-title {
    font-size: 11px;
    font-weight: 700;
    color: #F2F2F2;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    opacity: 0.9;
}

/* Calendar Components */
QWidget#day-cell {
    background-color: #1C1C1C;
    border: 1px solid #2B2B2B;
    border-radius: 4px;
}

QWidget#day-cell:hover {
    border: 1px solid #FF6524;
}

#day-number {
    font-size: 13px;
    font-weight: 600;
    color: #888888;
    background: transparent;
}

#day-number[today="true"] {
    color: #FF6524;
    font-weight: 800;
}

#calendar-header-label {
    font-weight: 700;
    color: #888888;
    padding: 12px;
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 2px;
}

#dot {
    background-color: #FF6524;
    border: none;
    border-radius: 4px;
}

#event-container {
    background: transparent;
}

#event-title {
    background: transparent;
    color: #F2F2F2;
    font-size: 11px;
    font-weight: 500;
}

/* Main Area Stack */
#main-stack {
    background-color: #111111;
}

/* Forms & Inputs */
QLineEdit, QTextEdit, QComboBox {
    background-color: #2B2B2B;
    border: 1px solid #2B2B2B;
    border-radius: 6px;
    padding: 8px 12px;
    color: #F2F2F2;
    selection-background-color: #FF6524;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #FF6524;
}

QLabel#form-label {
    font-weight: 600;
    color: #888888;
    margin-bottom: 4px;
}

/* ScrollBars */
QScrollBar:vertical {
    border: none;
    background: #111111;
    width: 8px;
    margin: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #111111;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #2B2B2B;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #2B2B2B;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #888888;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Tables */
QTableView, QTableWidget {
    background-color: #111111;
    alternate-background-color: #1C1C1C;
    border: none;
    gridline-color: #2B2B2B;
    color: #F2F2F2;
}

QHeaderView::section {
    background-color: #1C1C1C;
    color: #888888;
    padding: 10px;
    border: none;
    border-bottom: 1px solid #2B2B2B;
    font-weight: 600;
}

/* List Widgets */
QListWidget {
    background-color: #111111;
    border: none;
    outline: none;
    padding: 5px;
}

QListWidget::item {
    background-color: #1C1C1C;
    color: #F2F2F2;
    padding: 12px;
    border-radius: 8px;
    margin-bottom: 8px;
    border: 1px solid #2B2B2B;
}

QListWidget::item:selected {
    border: 1px solid #FF6524;
    background-color: #2B2B2B;
}

QListWidget::item:hover {
    background-color: #2B2B2B;
}

QWidget#task-card {
    background-color: #1C1C1C;
    border: none;
    border-radius: 12px;
    padding: 16px;
}

QLabel#task-title {
    font-size: 14px;
    font-weight: bold;
    color: #F2F2F2;
}

QLabel#muted-text {
    color: #888888;
    font-size: 12px;
}

QLabel#badge-outline {
    border: 1px solid #FF6524;
    color: #FF6524;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 10px;
    qproperty-alignment: AlignCenter;
}

QLabel#badge-todo {
    background-color: #888888;
    color: #111111;
    border: 1px solid transparent;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: bold;
    qproperty-alignment: AlignCenter;
}
QLabel#badge-in_progress {
    background-color: #FF6524;
    color: #111111;
    border: 1px solid transparent;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: bold;
    qproperty-alignment: AlignCenter;
}
QLabel#badge-completed {
    background-color: #3A3A3A;
    color: #F2F2F2;
    border: 1px solid transparent;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: bold;
    qproperty-alignment: AlignCenter;
}
QLabel#badge-cancelled {
    background-color: #E8311A;
    color: #111111;
    border: 1px solid transparent;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: bold;
    qproperty-alignment: AlignCenter;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget {
    background: transparent;
}

QWidget#grid-container {
    background: transparent;
}