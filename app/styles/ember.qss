QMainWindow, QWidget {
    background-color: {VOID};
    color: {SMOKE};
    font-family: "Inter";
}

/* Sidebar styling */
#sidebar {
    background-color: {CHARCOAL};
    border-right: 1px solid {ASH};
    min-width: 200px;
}

#sidebar-logo {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 20px;
    padding-left: 20px;
    color: {EMBER};
}

QPushButton#nav-btn {
    background-color: transparent;
    color: {CINDER};
    text-align: left;
    padding: 12px 20px;
    border: none;
    font-weight: 500;
}

QPushButton#nav-btn:hover {
    color: {SMOKE};
    background-color: {ASH};
}

QPushButton#nav-btn:checked {
    color: {EMBER};
    background-color: {ASH};
}

QPushButton#primary {
    background-color: {EMBER};
    color: {WHITE};
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    font-weight: 600;
}

QPushButton#primary:hover {
    background-color: {BURN};
}

QWidget#stat-card {
    background-color: {BURN};
    border-radius: 10px;
    padding: 16px;
}

QWidget#day-cell {
    background-color: {CHARCOAL};
    border: 1px solid {ASH};
    border-radius: 8px;
}

QLabel#dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background-color: {EMBER};
}

QLabel {
    background-color: inherit;
}
