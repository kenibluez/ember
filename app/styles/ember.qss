QMainWindow {
    background-color: {VOID};
    color: {SMOKE};
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

QWidget {
    color: {SMOKE};
}

/* Sidebar styling */
#sidebar {
    background-color: {CHARCOAL};
    border-right: 1px solid {ASH};
    min-width: 220px;
}

#sidebar-logo {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 20px;
    padding: 30px 20px;
    color: {EMBER};
}

QPushButton#nav-btn {
    background-color: transparent;
    color: {CINDER};
    text-align: left;
    padding: 12px 24px;
    border: none;
    font-weight: 500;
    font-size: 14px;
    border-radius: 0px;
}

QPushButton#nav-btn:hover {
    color: {SMOKE};
    background-color: {ASH};
}

QPushButton#nav-btn:checked {
    color: {EMBER};
    background-color: {VOID};
    border-left: 3px solid {EMBER};
}

/* Primary Action Button */
QPushButton#primary {
    background-color: {EMBER};
    color: {WHITE};
    padding: 10px 24px;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    font-size: 14px;
}

QPushButton#primary:hover {
    background-color: {BURN};
}

QPushButton#primary:pressed {
    background-color: {BURN};
    padding-top: 11px;
    padding-bottom: 9px;
}

/* Secondary/Ghost Button */
QPushButton#secondary {
    background-color: {ASH};
    color: {SMOKE};
    padding: 10px 24px;
    border: none;
    border-radius: 6px;
    font-weight: 500;
    font-size: 14px;
}

QPushButton#secondary:hover {
    background-color: {CHARCOAL};
    border: 1px solid {ASH};
}

/* View Switcher */
#view-switcher-btn {
    background-color: {ASH};
    color: {CINDER};
    padding: 8px 16px;
    border: none;
    border-radius: 4px;
    font-weight: 500;
    font-size: 12px;
    margin-right: 4px;
}

#view-switcher-btn:hover {
    background-color: {CHARCOAL};
    color: {SMOKE};
}

#view-switcher-btn:checked {
    background-color: {EMBER};
    color: {WHITE};
}

/* Stat Card */
QWidget#stat-card {
    background-color: {CHARCOAL};
    border: 1px solid {ASH};
    border-radius: 12px;
    padding: 20px;
}

#stat-value {
    font-size: 32px;
    font-weight: 700;
    color: {EMBER};
}

#stat-title {
    font-size: 12px;
    font-weight: 600;
    color: {CINDER};
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Calendar Components */
QWidget#day-cell {
    background-color: {CHARCOAL};
    border: 1px solid {ASH};
    border-radius: 4px;
}

QWidget#day-cell:hover {
    border: 1px solid {EMBER};
}

#day-number {
    font-size: 14px;
    font-weight: 500;
    color: {CINDER};
}

#day-number[today="true"] {
    color: {EMBER};
    font-weight: 700;
}

#calendar-header-label {
    font-weight: 600;
    color: {CINDER};
    padding: 10px;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 1px;
}

/* Forms & Inputs */
QLineEdit, QTextEdit, QComboBox {
    background-color: {ASH};
    border: 1px solid {ASH};
    border-radius: 6px;
    padding: 8px 12px;
    color: {SMOKE};
    selection-background-color: {EMBER};
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid {EMBER};
}

QLabel#form-label {
    font-weight: 600;
    color: {CINDER};
    margin-bottom: 4px;
}

/* ScrollBars */
QScrollBar:vertical {
    border: none;
    background: {VOID};
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: {ASH};
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: {CINDER};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Tables */
QTableWidget {
    background-color: {VOID};
    alternate-background-color: {CHARCOAL};
    border: none;
    gridline-color: {ASH};
}

QHeaderView::section {
    background-color: {CHARCOAL};
    color: {CINDER};
    padding: 10px;
    border: none;
    border-bottom: 1px solid {ASH};
    font-weight: 600;
}

/* List Widgets */
QListWidget {
    background-color: {VOID};
    border: none;
    outline: none;
    padding: 5px;
}

QListWidget::item {
    background-color: {CHARCOAL};
    color: {SMOKE};
    padding: 12px;
    border-radius: 8px;
    margin-bottom: 8px;
    border: 1px solid {ASH};
}

QListWidget::item:selected {
    border: 1px solid {EMBER};
    background-color: {ASH};
}

QListWidget::item:hover {
    background-color: {ASH};
}
